<?xml version="1.0" encoding="UTF-8"?>
<!-- Logback config for tests: suppress verbose third-party output. Same masking
     converter as production so the test pattern can be exercised end-to-end. -->
<configuration>

    <conversionRule conversionWord="mask"
                    class="com.recetea.infrastructure.logging.SensitiveDataMaskingConverter"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} [TraceID: %X{correlationId:-NONE}] [User: %X{userId:-anonymous}] - %mask(%msg%n)</pattern>
        </encoder>
    </appender>

    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.postgresql"    level="WARN"/>
    <logger name="com.sun.xml"       level="WARN"/>
    <logger name="com.recetea"       level="INFO"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
