<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import com.recetea.infrastructure.ui.javafx.features.recipe.components.RecipeHeaderComponent?>
<?import com.recetea.infrastructure.ui.javafx.features.recipe.components.IngredientTableComponent?>
<?import com.recetea.infrastructure.ui.javafx.features.recipe.components.MediaUploadComponent?>
<?import com.recetea.infrastructure.ui.javafx.features.recipe.components.StepTableComponent?>

<!-- Outer StackPane is the SCENE ROOT — it carries the .root gradient declared
     in app.css. The ScrollPane nested inside is transparent (edge-to-edge) and
     handles scroll for short windows without erasing the page background.
     Inner TableViews keep their prefHeight=200 internal scroll, so the outer
     ScrollPane only kicks in when the form's overall height exceeds the window. -->
<StackPane maxWidth="Infinity" maxHeight="Infinity"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">

    <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                styleClass="edge-to-edge">

        <VBox spacing="20.0">

            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <Label fx:id="formTitleLabel" styleClass="header-label" />

            <RecipeHeaderComponent fx:id="headerComponent" />

            <IngredientTableComponent fx:id="ingredientTableComponent" />

            <StepTableComponent fx:id="stepTableComponent" />

            <MediaUploadComponent fx:id="mediaUploadComponent" />

            <HBox alignment="CENTER_RIGHT" spacing="15.0">
                <Button text="%form.button.cancel"
                        styleClass="secondary-button"
                        onAction="#onBackButtonClick" />

                <Button fx:id="submitButton"
                        styleClass="primary-button"
                        onAction="#onSaveButtonClick" />
            </HBox>

        </VBox>

    </ScrollPane>

</StackPane>
