<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Global sensitive-data scrubber: strips BCrypt hashes and JWT-shaped tokens
         (e.g. Supabase service-role keys) from every formatted message before it
         reaches an appender. Last-line-of-defence for cases where a developer
         forgets to wrap a value in MaskingUtils at the call site, or where a
         pre-formatted string from a third-party library carries the secret. -->
    <conversionRule conversionWord="mask"
                    class="com.recetea.infrastructure.logging.SensitiveDataMaskingConverter"/>

    <property name="LOG_DIR"     value="logs"/>
    <!-- TraceID + User: both keys populated by ExecutionContext.withFreshContext.
         Defaults: NONE (no scope active) and 'anonymous' (logged-out / pre-login flow).
         %n is folded INSIDE the %mask(...) composite: Logback 1.5.32's pattern compiler
         occasionally fails to re-enter the converter chain after a CompositeConverter, so
         %n placed outside the composite was being emitted as the literal two characters
         '%' and 'n'. Folding it inside lets the composite's child chain render the newline
         and the masking transform leaves the trailing line break untouched. -->
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{40} [TraceID: %X{correlationId:-NONE}] [User: %X{userId:-anonymous}] - %mask(%msg%n)"/>

    <!-- Console: coloured, concise — used in development and Docker stdout -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Rolling file: daily rotation, 10 MB cap per file, 30 days / 200 MB total -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/recetea.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/recetea.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ── Third-party noise reduction ───────────────────────────────── -->
    <!-- HikariCP pool lifecycle: only warnings and above -->
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <!-- PostgreSQL JDBC driver internals -->
    <logger name="org.postgresql"    level="WARN"/>
    <!-- JAXB: suppress INFO-level marshalling chatter -->
    <logger name="com.sun.xml"       level="WARN"/>

    <!-- ── Application loggers ────────────────────────────────────────── -->
    <!-- Domain + use-cases: INFO so operational events are visible -->
    <logger name="com.recetea.core"           level="INFO"/>
    <!-- Infrastructure layer: WARN in prod, raise to DEBUG when diagnosing -->
    <logger name="com.recetea.infrastructure" level="WARN"/>

    <!-- Root: catch anything not matched above -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
