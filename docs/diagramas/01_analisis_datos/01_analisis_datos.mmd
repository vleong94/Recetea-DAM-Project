---
config:
  layout: dagre
---
flowchart TB
%% Inicio del viaje
    U["👨‍🍳 <b>EL COCINERO</b>"] --> ACTION{"<b>¿Qué desea hacer?</b>"}

    subgraph ORIGEN ["📝 <b>FLUJO DE CREACIÓN (Origen del Dato)</b>"]
        direction TB
        NEW["📄 <b>Información Base</b><br>(Título, porciones y tiempos)"]
        MEDIA["🖼️ <b>Material Visual</b><br>(Galería de imágenes)"]
        ING["🥕 <b>Detalle Técnico</b><br>(Ingredientes y cantidades precisas)"]
        ST["📜 <b>Guía Operativa</b><br>(Pasos e instrucciones)"]
        TAG["🏷️ <b>Clasificación</b><br>(Categorías y etiquetas sociales)"]

        NEW --> MEDIA --> ING --> ST --> TAG
    end

%% Punto de Consolidación
    CATALOG["🌐 <b>CATÁLOGO COMUNITARIO</b><br>(Repositorio Central de Información)"]

    subgraph DESTINO ["👁️ <b>FLUJO DE CONSUMO (Uso del Dato)</b>"]
        direction TB
        SEARCH["🔍 <b>Filtros y Búsqueda</b><br>(Acceso por relevancia y popularidad)"]
        VIEW["🍲 <b>Ficha de Receta</b><br>(Integración de toda la información)"]

        SEARCH --> VIEW
    end

%% Relaciones de viaje
    ACTION == "Aportar Contenido" ==> NEW
    TAG -- "Se consolida en" --> CATALOG
    CATALOG -- "Alimenta el" --> SEARCH

%% Retroalimentación (El dato vuelve al origen)
    VIEW -- "Persistencia" --> FAV["⭐ <b>Favoritos</b><br>(Colección personal)"]
    VIEW -- "Enriquecimiento" --> VAL["💬 <b>Feedback</b><br>(Valoraciones y comentarios)"]

    VAL -. "Actualiza popularidad" .-> CATALOG
    ACTION == "Consultar Catálogo" ==> SEARCH

%% Estilos Visuales
    style U fill:#fffafc,stroke:#8e24aa,stroke-width:2px
    style CATALOG fill:#e1f5fe,stroke:#01579b,stroke-width:2px,font-weight:bold
    style VAL fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px